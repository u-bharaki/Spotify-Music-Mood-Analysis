# Seeder, Simulator ve Superset-Init için ortak taban
FROM python:3.10-slim

WORKDIR /app

# Sistem bağımlılıkları (psycopg2 vb. için gerekebilir)
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Projedeki tüm dosyaları (Kodlar + Datasets) imajın içine kopyala
# NOT: build context proje kökü (".") olmalı; "COPY .. /app/" Docker'da
# context dışına çıktığı için HATA verir, bu yüzden "COPY . /app/" kullanılır.
COPY . /app/

# Gerekli kütüphaneleri kur
RUN pip install pandas redis kafka-python requests psycopg2-binary